# ==============================================================================
# Oportia Jobs IA - Configuración de Entorno (Backend)
# ==============================================================================

# Entorno de ejecución: development | production
ENVIRONMENT=development

# Puerto del servidor backend (por defecto 8000)
PORT=8000
HOST=0.0.0.0

# Orígenes CORS permitidos separados por comas
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Versión del sistema
VERSION=1.3.6

# Proveedor predeterminado de IA (gemini | claude | openai)
DEFAULT_PROVIDER=gemini

# Modelos recomendados
GEMINI_MODEL=gemini-2.5-flash
CLAUDE_MODEL=claude-3-7-sonnet-latest
OPENAI_MODEL=gpt-4o-mini

# IA gratuita de Oportia: clave de Gemini del servidor, compartida con cupo diario.
# Se usa solo cuando la persona NO tiene clave propia y aceptó el aviso de privacidad en Ajustes
# (plan gratuito: Google puede usar el contenido para mejorar sus productos).
# Sin GEMINI_API_KEY, la IA gratuita queda desactivada y solo funciona la clave propia (BYOK).
# GEMINI_API_KEY=tu_clave_aqui
# SHARED_AI_ENABLED=true
# SHARED_AI_DAILY_LIMIT_PER_USER=15      # consultas por navegador al día
# SHARED_AI_DAILY_LIMIT_PER_IP=45        # por IP (varias personas pueden compartirla)
# SHARED_AI_DAILY_LIMIT_TOTAL=500        # total de la app al día (ajústalo a la cuota gratuita de tu proyecto)

# Opcional: otras claves del mantenedor (ya no se usan sin clave del usuario; la IA gratuita es solo Gemini)
# ANTHROPIC_API_KEY=tu_clave_aqui
# OPENAI_API_KEY=tu_clave_aqui

# Índice diario (lectura) y opiniones "¿Qué te parece Oportia?" (solo la clave PUBLICABLE)
# SUPABASE_URL=https://<proyecto>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
