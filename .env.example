# ==============================================================================
# Oportia Jobs IA - Configuración de Entorno (Backend)
# ==============================================================================

# Entorno de ejecución: development | production
ENVIRONMENT=development

# Puerto del servidor backend (por defecto 8000)
PORT=8000
HOST=0.0.0.0

# Orígenes CORS permitidos separados por comas
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Versión del sistema
VERSION=1.1.0

# Proveedor predeterminado de IA (gemini | claude | openai)
DEFAULT_PROVIDER=gemini

# Modelos recomendados
GEMINI_MODEL=gemini-2.5-flash
CLAUDE_MODEL=claude-3-7-sonnet-latest
OPENAI_MODEL=gpt-4o-mini

# Opcional: Claves para pruebas locales del mantenedor en servidor (el usuario final usa BYOK cifrado en el cliente)
# GEMINI_API_KEY=tu_clave_aqui
# ANTHROPIC_API_KEY=tu_clave_aqui
# OPENAI_API_KEY=tu_clave_aqui
